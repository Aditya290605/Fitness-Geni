## Provider State

```dart
class MealCatalogState {
  final Map<String, List<CatalogMeal>> allCandidates;
  final Map<String, List<ScoredMeal>> options;        // 1-4 per section
  final Map<String, CatalogMeal?> selections;
  final MacroBudget daily;
  final String goal;
  final List<String> yesterdayMealIds;
  final Map<String, int> starvationLevels;            // section → recovery level
  final bool isLoading;
  final String? error;

  // INV-8: computed, never stored
  MacroBudget get remaining =>
    daily - selections.values.whereType<CatalogMeal>()
      .fold(MacroBudget.zero, (s, m) => s + m.macros);

  int get completedSelections =>
    selections.values.where((v) => v != null).length;
  bool get allSelected => completedSelections == 4;
}
```

